---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import { ThreeDeeCard } from "../react/ThreeDeeCard";
import { ServicesCarousel } from "@components/react/ServicesCarousel";

let url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(Astro.url);

const services = Object.values(t("sections.services"));
const servicesSectionTitle = t("sections.services.title");
---

<div class="w-full p-4 sm:p-10">
  <ServicesCarousel
    client:only="react"
    data={services}
    title={servicesSectionTitle}
    lang={lang}
  />
</div>
