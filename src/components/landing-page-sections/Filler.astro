---
import { useTranslations } from "src/i18n/utils";
import TailwindButton from "../react/ui/Button";
const t = useTranslations(Astro.url);
const isMobile = () => {
  return /Mobi|Android/i.test(navigator.userAgent);
};
---

<div class="bg-black flex flex-col items-center h-full md:p-20 p-2">
  <div class="bg-black flex flex-col lg:flex-row items-center h-full p-20 gap-4">
    <img src="images/searching.png" alt="" class="flex flex-grow" />

    <div class="flex flex-col gap-10">
      <h4 class="md:text-7xl text-4xl font-bold text-center">{t("sections.filler.title")}</h4>
      <p>
        {t("sections.filler.text")}
      </p>
    </div>
  </div>
  <TailwindButton text={t("button.contact")} url="tetst" client:only="react" class="mobile-content"/>

</div>
